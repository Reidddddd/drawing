        <mxCell id="2HKgyRLbS_cYaW1hCSwe-41" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;入户鞋柜&lt;/h1&gt;&lt;p&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;长鞋柜处无底版&lt;/span&gt;&lt;/li&gt;&lt;li&gt;需要可活动/调节层板&lt;/li&gt;&lt;li&gt;有透气设计&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
